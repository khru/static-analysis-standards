          "type": "object",
        },
      ],
      "type": "problem",
    },
  },
  "quality/no-mixed-abstraction-levels": {
    "defaultOptions": undefined,
    "meta": {
      "docs": {
        "description": "Problem: one function combines inline computation with collaborator orchestration. Origin: mechanism was added beside policy. Why: the boundary is unclear and changes have broad impact. Solutions: extract mechanism behind a port/adapter and keep one abstraction level per method.",
      },
      "messages": {
        "mixedAbstractionLevels": "Function body mixes abstraction levels: it performs inline computation or manual iteration while also orchestrating collaborators. Keep the direct statements of a body at a single level of abstraction.",
      },
      "schema": [],
      "type": "problem",
    },
  },
  "quality/no-mixed-effect-categories": {
    "defaultOptions": undefined,
    "meta": {
      "docs": {
        "description": "Problem: a function returns a value while also mutating state. Origin: query and command behavior were combined. Why: ordering, retries and tests become difficult. Solutions: separate query and command and isolate mutation behind a collaborator.",
      },
      "messages": {
        "mixedEffectCategories": "Function mixes a query (returns a value) with a command (mutates state). Split it into a pure query and a pure command.",
      },
      "schema": [],
      "type": "problem",
    },
  },
  "quality/no-nested-ternary": {
    "defaultOptions": undefined,
    "meta": {
      "docs": {
        "description": "Problem: a conditional expression contains another conditional expression. Origin: compact syntax replaced named decision logic. Why: evaluation order and edge cases are hard to scan. Solutions: use guard clauses or a named decision function.",
      },
      "messages": {
        "nestedTernary": "Nested ternary obscures intent (Conditional Complexity). Extract the condition into a method or use guard clauses.",
      },
      "schema": [],
      "type": "problem",
    },
  },
  "quality/no-public-mutable-properties": {
    "defaultOptions": undefined,
    "meta": {
      "docs": {
        "description": "Problem: a domain/application class exposes a mutable instance property publicly. Origin: representation became the object's API. Why: callers can bypass invariants and coupling spreads to every consumer. Solutions: make the state readonly/private or expose an intention-revealing operation/value object.",
      },
      "messages": {
        "exposed": "Review candidate: public mutable property '{{name}}' exposes object state. Prefer a readonly/value-object boundary or an intention-revealing operation that preserves the invariant.",
      },
      "schema": [],
      "type": "suggestion",
    },
  },
  "quality/no-static-service-locator": {
    "defaultOptions": undefined,
    "meta": {
      "docs": {
        "description": "Problem: mutable static state or a self-constructing locator hides composition. Origin: ambient lookup replaced explicit wiring. Why: dependencies are invisible and state leaks between tests. Solutions: compose at the root and inject typed ports/factories.",
      },
      "messages": {
        "staticMutableState": "Static mutable state acts as a service locator (Global Data). Inject dependencies instead.",
        "staticSelfReturning": "Static method returns a new instance of its own class (service locator). Use an injected factory or an instance method (Inappropriate Static).",
      },
      "schema": [],
      "type": "problem",
    },
  },
  "quality/no-stringly-typed-dispatch": {
    "defaultOptions": undefined,
    "meta": {
      "docs": {
        "description": "Problem: strings select behavior through switch or if chains. Origin: closed variants were represented as arbitrary text. Why: renames and unsupported values evade the compiler. Solutions: use a discriminated union and typed data-driven map.",
      },
      "messages": {
        "stringIfChainDispatch": "This if chain dispatches on raw string literals. Dispatch through a typed discriminant and a data-driven table instead.",
        "stringSwitchDispatch": "This switch dispatches on raw string literals. Dispatch through a typed discriminant and a data-driven table instead.",
      },
      "schema": [],
      "type": "problem",
    },
  },
  "quality/no-type-embedded-in-name": {
    "defaultOptions": undefined,
    "meta": {
      "docs": {
        "description": "Problem: an annotated identifier repeats a primitive or collection representation such as String, List, Map or Set. Origin: implementation type was used as the name instead of the domain concept. Why: representation leaks into callers and a later type change forces needless renames. Solutions: name the role, identity, state or concept and leave representation to the type annotation.",
      },
      "messages": {
        "typeEmbedded": "Name '{{name}}' embeds the primitive type '{{type}}'. The type annotation already carries that information; rename it to express the domain concept instead.",
      },
      "schema": [],
      "type": "suggestion",
    },
  },
  "quality/no-uncommunicative-names": {
    "defaultOptions": undefined,
    "meta": {
      "docs": {
        "description": "Problem: vague or one-character names hide intent. Origin: placeholder names survived implementation growth. Why: every use requires source inspection. Solutions: name the role, effect, unit or business concept explicitly.",
      },
      "messages": {
        "uncommunicativeName": "Name '{{name}}' does not reveal its purpose. Rename it to describe what it holds or does.",
      },
      "schema": [],
      "type": "problem",
    },
  },
  "quality/null-check": {
    "defaultOptions": undefined,
    "meta": {
      "docs": {
        "description": "Problem: policy code compares values to null/undefined or uses typeof checks. Origin: validation was deferred past the boundary. Why: uncertainty spreads through policy code. Solutions: validate at the frontier and use a non-null value object/Option.",
      },
      "messages": {
        "nullCheck": "Review candidate: this defensive null/undefined check may signal missing invariants; evaluate a Null Object or Option model (tdd-refactor: Null Check).",
      },
      "schema": [],
      "type": "suggestion",
    },
  },
  "quality/one-dot-per-line": {
    "defaultOptions": undefined,
    "meta": {
      "docs": {
        "description": "Problem: an ordinary call chain traverses multiple methods. Origin: callers navigate object graphs directly. Why: ownership boundaries and Law of Demeter are obscured. Solutions: add behavior to the owner or introduce a focused port.",
      },
      "messages": {
        "oneDotPerLine": "Review candidate: chained call '{{chain}}' spans more than one level; consider expressing each step as its own statement (Calisthenics: one dot per line).",
      },
      "schema": [],
      "type": "suggestion",
    },
  },
  "quality/prefer-data-driven-dispatch": {
    "defaultOptions": undefined,
    "meta": {
      "docs": {
        "description": "Problem: a switch with single-return cases encodes a lookup table. Origin: variants accumulated as branches. Why: new cases require control-flow edits and omissions are easy. Solutions: use a typed map/catalog with explicit missing-key handling.",
      },
      "messages": {
        "mappingSwitch": "This switch only maps cases to returned values. Replace it with a data-driven lookup table keyed by a typed discriminant.",
      },
      "schema": [],
      "type": "problem",
    },
  },
  "quality/prefer-intl-date-formatting": {
    "defaultOptions": undefined,
    "meta": {
      "docs": {
