  },
  "quality/prefer-utc-date-getters": {
    "defaultOptions": undefined,
    "meta": {
      "docs": {
        "description": "Problem: local date getters are called. Origin: a UTC instant was interpreted with local calendar methods. Why: results vary by machine timezone. Solutions: use UTC getters or a domain time abstraction.",
      },
      "messages": {
        "localDateGetter": "Review candidate: '.{{localName}}' reads the local time zone. Prefer '.{{utcName}}' so the instant is explicit.",
      },
