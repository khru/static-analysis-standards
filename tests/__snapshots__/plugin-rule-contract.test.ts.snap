  "testing/no-test-control-flow": {
    "defaultOptions": undefined,
    "meta": {
      "docs": {
        "description": "Problem: recognized test callbacks contain if, loops, switch or ternary control flow. Origin: operational branching entered the example. Why: tests reproduce behavior or hide AAA. Solutions: move mechanics to fixtures/hooks and use semantic each cases.",
      },
      "messages": {
        "testControlFlow": "Test cases contain no branches or loops. Extract the decision into the system under test or parameterize with it.each/test.each (Conditional Test Logic).",
      },
