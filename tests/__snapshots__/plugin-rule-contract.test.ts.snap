  "quality/no-magic-strings": {
    "defaultOptions": [
      {
        "allowlist": [],
      },
    ],
    "meta": {
      "docs": {
        "description": "Problem: an unexplained string appears in domain/application policy. Origin: a state/event vocabulary was duplicated inline. Why: typos and inconsistent states become silent behavior changes. Solutions: use a closed catalog, enum or discriminant constant.",
      },
      "messages": {
        "magicString": "String literal {{value}} is used inline in logic. Extract it into a named constant, catalog or typed discriminant so the meaning is explicit.",
      },
      "schema": [
        {
          "additionalProperties": false,
          "properties": {
            "allowlist": {
              "items": {
